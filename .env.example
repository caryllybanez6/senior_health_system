# Copy this file to .env and fill in the values for local development
# Railway may inject the equivalent values automatically when using MySQL service.

# MySQL / MariaDB settings
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=senior_health_system
MYSQL_PORT=3306

# Railway MySQL settings (preferred if using Railway service)
RAILWAY_MYSQL_HOST=
RAILWAY_MYSQL_USER=
RAILWAY_MYSQL_PASSWORD=
RAILWAY_MYSQL_DATABASE=
RAILWAY_MYSQL_PORT=3306

# Fallback settings for Railway
RAILWAY_HOST=
RAILWAY_USER=
RAILWAY_PASSWORD=
RAILWAY_DATABASE=
RAILWAY_PORT=3306

# Email config (optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Secret key (optional; if not set, a random one is generated)
SECRET_KEY=
